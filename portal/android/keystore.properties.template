# Release signing for the NIETE Android app — TEMPLATE.
#
# Copy to `keystore.properties` (gitignored) or supply these as environment
# variables in CI. NEVER commit the real file or the .jks itself.
#
# The existing NIETE app's build keeps its keystore and passwords in plain text
# inside its repository. We inherit the KEY (Play requires the same signing
# identity to update the listing) but not that practice.
#
# The signing identity is fixed: the certificate issued to NIETE
# (O=Orenda Pvt Ltd, Islamabad), valid to Feb 2049. A build signed with any
# other key cannot update the existing Play listing.

# Absolute path to the NIETE release keystore (keep it outside this repo)
NIETE_KEYSTORE_PATH=/secure/path/to/niete-app.jks
NIETE_KEYSTORE_PASSWORD=
NIETE_KEY_ALIAS=niete
NIETE_KEY_PASSWORD=
